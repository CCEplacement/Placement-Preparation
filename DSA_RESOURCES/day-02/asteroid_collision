class Solution {
    public int[] asteroidCollision(int[] balls) {

        Stack<Integer> stack = new Stack<>();

        for (int ball : balls) {

            boolean destroyed = false;

            while (!stack.isEmpty() && stack.peek() > 0 && ball < 0) {

                if (Math.abs(stack.peek()) < Math.abs(ball)) {
                    stack.pop();
                }
                else if (Math.abs(stack.peek()) == Math.abs(ball)) {
                    stack.pop();
                    destroyed = true;
                    break;
                }
                else {
                    destroyed = true;
                    break;
                }
            }

            if (!destroyed) {
                stack.push(ball);
            }
        }

        // Convert stack to array
        int[] ans = new int[stack.size()];

        for (int i = stack.size() - 1; i >= 0; i--) {
            ans[i] = stack.pop();
        }

        return ans;
    }
}
